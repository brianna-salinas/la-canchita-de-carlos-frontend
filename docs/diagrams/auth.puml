@startuml auth-module
title Módulo Frontend: Auth (Sesión, Login, Verificación)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "auth (model & context)" {
  class AuthUser {
    +id: number
    +name: string
    +email: string
    +isOwner: boolean
    +photoUrl?: string
    +username?: string
  }

  interface AuthContextValue {
    +user: AuthUser?
    +login(usernameOrEmail, password): Promise<void>
    +logout(): void
    +updateUser(changes): void
  }

  class AuthProvider << (C,lightgreen) React Context Provider >> {
    +login(usernameOrEmail, password): Promise<void>
    +logout(): void
    +updateUser(changes): void
    -refrescarFoto(): Promise<void>
  }

  class "useAuth()" as useAuth << (F,orchid) hook >>

  AuthProvider ..|> AuthContextValue
  AuthProvider --> AuthUser
  useAuth ..> AuthContextValue
  AuthProvider ..> "shared.api.client"
}

package "auth.components" {
  class LoginPage
  class ForgotPasswordPage
  class RequestAccessPage
  class AuthLayout
  class VerificarCorreoPage

  LoginPage ..> useAuth
  RequestAccessPage ..> "shared.api.client"
  ForgotPasswordPage ..> "shared.api.client"
  VerificarCorreoPage ..> "shared.api.client"
  LoginPage --> AuthLayout
  ForgotPasswordPage --> AuthLayout
  RequestAccessPage --> AuthLayout
}

@enduml

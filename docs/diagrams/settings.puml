@startuml settings-module
title Módulo Frontend: Settings (Ajustes, Usuarios, Solicitudes de acceso)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "settings.hooks (model)" {
  class AccessRequest {
    +id: number
    +name: string
    +email: string
    +createdAt: string
    +status: 'PENDING'|'APPROVED'|'REJECTED'
  }

  class AdminUser {
    +id: number
    +name: string
    +email: string
    +isOwner: boolean
    +status: 'ACTIVE'|'INACTIVE'
    +lastAccess?: string
    +photoUrl?: string
  }

  class AccessRequestApiRow << (D,lightblue) DTO backend >> {
    +id: number
    +name: string
    +email: string
    +createdAt: string
  }

  class AdminUserApiRow << (D,lightblue) DTO backend >> {
    +id: number
    +name: string
    +email: string
    +isOwner: boolean
    +lastAccess?: string
    +photoUrl?: string
  }
}

package "settings.hooks (queries, mutations and utilities)" {
  class useAccessRequests << (F,orchid) query >> {
    +(): UseQueryResult<AccessRequest[]>
  }
  class useApproveAccessRequest << (F,orchid) mutation >> {
    +(request): Promise<void>
  }
  class useRejectAccessRequest << (F,orchid) mutation >> {
    +(id): Promise<void>
  }
  class useAdminUsers << (F,orchid) query >> {
    +(): UseQueryResult<AdminUser[]>
  }
  class useDeactivateAdminUser << (F,orchid) mutation >> {
    +(userId): UseMutationResult<void>
  }
  class "formatRelativeDate()" as formatRelativeDate << (F,orchid) function >> {
    +(iso): string
  }
  class "formatLastActive()" as formatLastActive << (F,orchid) function >> {
    +(iso?): string
  }

  useAccessRequests ..> AccessRequestApiRow
  useAccessRequests ..> AccessRequest
  useApproveAccessRequest ..> AccessRequest
  useRejectAccessRequest ..> AccessRequest
  useAdminUsers ..> AdminUserApiRow
  useAdminUsers ..> AdminUser
  useDeactivateAdminUser ..> AdminUser
  formatRelativeDate ..> AccessRequest
  formatLastActive ..> AdminUser
}

package "settings.components" {
  class AjustesPage
  class SolicitudesAccesoPage
  SolicitudesAccesoPage ..> useAccessRequests
  SolicitudesAccesoPage ..> useApproveAccessRequest
  SolicitudesAccesoPage ..> useRejectAccessRequest
  SolicitudesAccesoPage ..> useAdminUsers
  SolicitudesAccesoPage ..> useDeactivateAdminUser
  AjustesPage ..> useAccessRequests
  AjustesPage ..> useApproveAccessRequest
  AjustesPage ..> useRejectAccessRequest
}

@enduml

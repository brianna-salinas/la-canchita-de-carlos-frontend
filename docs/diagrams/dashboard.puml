@startuml dashboard-module
title Módulo Frontend: Dashboard (Panel)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "dashboard.hooks (model)" {
  class Booking {
    +id: number
    +courtId: number
    +courtName: string
    +customerId: number?
    +customerName: string
    +type?: string
    +date: string
    +startTime: string
    +endTime: string
    +status: string
    +paymentStatus: 'PAID'|'PARTIAL'|'PENDING'
    +totalAmount: number
    +paidAmount: number
    +bookingType?: 'SINGLE'|'MULTIDAY'|'RECURRING'
    +seriesId?: string
    +seriesPaymentMode?: 'INDIVIDUAL'|'LUMP_SUM'
    +seriesLabel?: string
    +seriesTotalDates?: number
    +seriesIndex?: number
  }

  class NextFreeSlot {
    +startTime: string
    +courtName: string
    +courtId: number
  }

  class DayOccupancy {
    +date: Date
    +percentage: number
  }
}

package "dashboard.hooks (queries and functions)" {
  class useTodayBookings << (F,orchid) query >> {
    +(): UseQueryResult<Booking[]>
  }
  class "calculateSummary()" as calculateSummary << (F,orchid) function >> {
    +(bookings): ResumenPanel
  }
  class "dayPhrase()" as dayPhrase << (F,orchid) function >> {
    +(totalBookingsToday): string
  }
  class "calculateNextFreeSlot()" as calculateNextFreeSlot << (F,orchid) function >> {
    +(courts, bookings, now): NextFreeSlot?
  }
  class "calculateWeeklyOccupancy()" as calculateWeeklyOccupancy << (F,orchid) function >> {
    +(bookings, courts, now): DayOccupancy[]
  }

  useTodayBookings ..> Booking
  calculateSummary ..> Booking
  calculateNextFreeSlot ..> Booking
  calculateNextFreeSlot ..> NextFreeSlot
  calculateWeeklyOccupancy ..> Booking
  calculateWeeklyOccupancy ..> DayOccupancy
}

package "dashboard.components" {
  class PanelPage {
    +agruparBloqueosPorCancha(bloqueos): string[]
  }

  PanelPage ..> useTodayBookings
  PanelPage ..> calculateSummary
  PanelPage ..> dayPhrase
  PanelPage ..> calculateNextFreeSlot
  PanelPage ..> calculateWeeklyOccupancy
  PanelPage ..> "bookings.hooks.useCourts"
  PanelPage ..> "bookings.hooks.useScheduleBlocks"
}

@enduml

@startuml customers-module
title Módulo Frontend: Customers

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "customers.hooks (model)" {
  class Customer {
    +id: number
    +name: string
    +phone: string
    +documentNumber?: string
    +status?: 'ACTIVE' | 'INACTIVE'
    +photoUrl?: string
  }

  class CustomerApiRow << (D,lightblue) DTO backend >> {
    +id: number
    +name: string
    +phone: string
    +documentNumber?: string
    +status?: string
    +photoUrl?: string
  }

  class "mapCustomerRow()" as mapCustomerRow << (F,orchid) mapper >>
  mapCustomerRow ..> CustomerApiRow
  mapCustomerRow ..> Customer
}

package "customers.hooks (queries)" {
  class useCustomers << (F,orchid) query >> {
    +(): UseQueryResult<Customer[]>
  }
  useCustomers ..> mapCustomerRow
}

package "customers.components" {
  class ClientesPage
  ClientesPage ..> useCustomers
}

@enduml

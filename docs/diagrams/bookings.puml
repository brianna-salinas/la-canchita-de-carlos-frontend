@startuml bookings-module
title Módulo: Bookings + Courts (Calendario, Reservas, Canchas)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "dashboard (tipo compartido)" {
  interface Alquiler {
    +id: number
    +canchaId: number
    +canchaNombre: string
    +clienteId: number | null
    +clienteNombre: string
    +tipo?: string
    +fecha: string
    +horaInicio: string
    +horaFin: string
    +estado: string
    +estadoPago: "PAGADO" | "PARCIAL" | "PENDIENTE"
    +montoTotal: number
    +montoPagado: number
    +tipoReserva?: "UNICA" | "MULTIDIA" | "RECURRENTE"
    +serieId?: string
    +serieModoPago?: "INDIVIDUAL" | "ACUMULADO"
    +serieEtiqueta?: string
    +serieTotalFechas?: number
    +serieIndice?: number
  }
}

package "bookings" {
  interface Cancha {
    +id: number
    +nombre: string
    +deporte: string
    +superficie: string
    +precioHora: number
    +estado?: "ACTIVA" | "MANTENIMIENTO"
    +fotoUrl?: string
    +descripcion?: string
    +habilitada?: boolean
  }

  interface Bloqueo {
    +id: number
    +canchaId: number
    +canchaNombre: string
    +fecha: string
    +hora: string
    +motivo: string
  }

  class "useCanchas" as useCanchas << (F,orchid) hook >> {
    +() : UseQueryResult<Cancha[]>
  }

  class "useReservas" as useReservas << (F,orchid) hook >> {
    +() : UseQueryResult<Alquiler[]>
  }

  class "useBloqueos" as useBloqueos << (F,orchid) hook >> {
    +() : UseQueryResult<Bloqueo[]>
  }

  useCanchas ..> Cancha : trae
  useReservas ..> Alquiler : trae
  useBloqueos ..> Bloqueo : trae
  Bloqueo "*" --> "1" Cancha : canchaId
}

package "componentes (pantallas)" {
  class CalendarioPage << (P,#F08080) página >>
  class ReservasPage << (P,#F08080) página >>
  class NuevaReservaPage << (P,#F08080) página >>
  class CanchasPage << (P,#F08080) página >>
  class NuevaCanchaPage << (P,#F08080) página >>

  CalendarioPage ..> useReservas
  CalendarioPage ..> useBloqueos
  ReservasPage ..> useReservas
  NuevaReservaPage ..> useCanchas
  NuevaReservaPage ..> useReservas
  CanchasPage ..> useCanchas
  CanchasPage ..> useReservas
  NuevaCanchaPage ..> useCanchas
}

note bottom of useCanchas
  Fase de fake API (Sprint 1): todos estos hooks
  leen de json-server (db.json). Se reemplazan por
  GET /api/courts, /api/bookings, /api/court-blocks
  del backend real en Sprint 2.
  Nota: no existe carpeta "courts/hooks" separada;
  Canchas y Reservas comparten el mismo archivo de
  hooks (useCalendario.ts), igual que en el backend
  ambos aggregates viven en el bounded context Bookings.
end note

@enduml

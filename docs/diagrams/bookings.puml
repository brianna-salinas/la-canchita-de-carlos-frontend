@startuml bookings-module
title Módulo Frontend: Bookings (Reservas, Canchas, Mantenimientos)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "bookings.hooks (model)" {
  class Court {
    +id: number
    +name: string
    +sport: string
    +surface: string
    +pricePerHour: number
    +status?: 'ACTIVE' | 'MAINTENANCE'
    +photoUrl?: string
    +description?: string
    +enabled?: boolean
    +openTime?: string
    +closeTime?: string
  }

  class ScheduleBlock {
    +id: number
    +courtId: number
    +courtName: string
    +date: string
    +time: string
    +reason: string
  }

  class MaintenanceBlock {
    +id: number
    +date: string
    +time: string
    +reason: string
  }

  class ScheduleMaintenanceInput {
    +courtId: number
    +dates: string[]
    +startTime: string
    +endTime: string
    +reason?: string
  }

  class BookingApiRow << (D,lightblue) DTO backend >> {
    +id: number
    +courtId: number
    +court?: { name: string }
    +customerId?: number
    +customerName: string
    +type?: string
    +date: string
    +startTime: string
    +endTime: string
    +status: string
    +paymentStatus: string
    +totalAmount: number
    +paidAmount: number
    +bookingType?: string
    +seriesId?: string
    +seriesPaymentMode?: string
    +seriesLabel?: string
    +seriesTotalDates?: number
    +seriesIndex?: number
  }

  class "mapBookingRow()" as mapBookingRow << (F,orchid) mapper >>
  class "mapCourtRow()" as mapCourtRow << (F,orchid) mapper >>

  mapBookingRow ..> BookingApiRow
  mapCourtRow ..> Court
}

package "bookings.hooks (queries and mutations)" {
  class useCourts << (F,orchid) query >> {
    +(): UseQueryResult<Court[]>
  }
  class useAllCourts << (F,orchid) query >> {
    +(): UseQueryResult<Court[]>
  }
  class useBookings << (F,orchid) query >> {
    +(): UseQueryResult<Booking[]>
  }
  class useScheduleBlocks << (F,orchid) query >> {
    +(date): UseQueryResult<ScheduleBlock[]>
  }
  class useScheduleBlocksRange << (F,orchid) query >> {
    +(dates): { data: ScheduleBlock[], isLoading }
  }
  class useScheduleMaintenance << (F,orchid) mutation >> {
    +(): UseMutationResult<void, ScheduleMaintenanceInput>
  }
  class useUpcomingMaintenance << (F,orchid) query >> {
    +(courtId): UseQueryResult<MaintenanceBlock[]>
  }
  class useCancelMaintenanceBlock << (F,orchid) mutation >> {
    +(): UseMutationResult<void, number>
  }

  useCourts ..> Court
  useAllCourts ..> Court
  useBookings ..> mapBookingRow
  useScheduleBlocks ..> ScheduleBlock
  useScheduleBlocksRange ..> ScheduleBlock
  useScheduleMaintenance ..> ScheduleMaintenanceInput
  useUpcomingMaintenance ..> MaintenanceBlock
  useCancelMaintenanceBlock ..> MaintenanceBlock
}

package "bookings.components" {
  class CalendarioPage {
    +vista: 'dia' | 'semana' | 'mes'
  }
  class NuevaReservaPage {
    +tipoReserva: TipoReserva
    +metodoPago: MetodoPago
  }
  class ReservasPage {
    +pagoPendiente: PagoPendiente
  }
  class ProgramarMantenimientoModal
  class MantenimientosProgramadosModal

  CalendarioPage ..> useScheduleBlocks
  CalendarioPage ..> useScheduleBlocksRange
  CalendarioPage ..> useBookings
  CalendarioPage ..> useCourts
  CalendarioPage ..> ProgramarMantenimientoModal
  NuevaReservaPage ..> useCourts
  NuevaReservaPage ..> useBookings
  ReservasPage ..> useCourts
  ReservasPage ..> useBookings
  ProgramarMantenimientoModal ..> useScheduleMaintenance
  MantenimientosProgramadosModal ..> useUpcomingMaintenance
  MantenimientosProgramadosModal ..> useCancelMaintenanceBlock
  MantenimientosProgramadosModal ..> ProgramarMantenimientoModal
}

@enduml

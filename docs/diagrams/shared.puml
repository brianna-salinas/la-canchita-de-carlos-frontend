@startuml shared-module
title Módulo Frontend: Shared (API client, Notificaciones, Componentes base, Utilidades)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "shared.api" {
  class apiClient << (S,orange) axios instance >> {
    +baseURL: VITE_API_URL
    +interceptor: Authorization Bearer
  }
  class "getToken() / setToken()" as tokenHelpers << (F,orchid) function >> {
    +getToken(): string?
    +setToken(token?): void
  }
  class queryClient << (S,orange) TanStack QueryClient >>

  apiClient ..> tokenHelpers
}

package "shared.hooks (model)" {
  class Notification {
    +id: number
    +title: string
    +message: string
    +relativeTime: string
    +read: boolean
  }

  class NotificationApiRow << (D,lightblue) DTO backend >> {
    +id: number
    +title: string
    +message?: string
    +read: boolean
    +createdAt: string
  }

  class useNotifications << (F,orchid) query >> {
    +(): UseQueryResult<Notification[]>
  }
  class useMarkNotificationRead << (F,orchid) mutation >> {
    +(id): UseMutationResult<void>
  }

  useNotifications ..> NotificationApiRow
  useNotifications ..> Notification
  useMarkNotificationRead ..> Notification
  useNotifications ..> apiClient
}

package "shared.components" {
  class AppShell
  class ProtectedRoute
  class MetodoPagoIcon {
    +value: 'EFECTIVO'|'YAPE'|'OTRO'
    +className?: string
  }

  AppShell ..> useNotifications
  AppShell ..> useMarkNotificationRead
  AppShell ..> "auth.useAuth"
  ProtectedRoute ..> "auth.useAuth"
}

package "shared.utils" {
  class "date.ts" as dateUtils << (F,orchid) functions >> {
    +toISODate(d)
    +toHHmm(d)
    +hourToNum(hora)
    +getWeekDates(d)
  }
  class "format.ts" as formatUtils << (F,orchid) functions >> {
    +initials(name)
    +formatDate(iso)
  }
  class "api-error.ts" as apiErrorUtils << (F,orchid) functions >> {
    +getApiErrorMessage(err, fallback)
  }
  class "validation.ts" as validationUtils << (F,orchid) functions >> {
    +isValidPhone(phone)
    +isValidEmail(email)
    +isValidPrice(value)
  }

  apiErrorUtils ..> apiClient
}

@enduml
